# VITE_PRESENCE_ROOM_CAPACITY=30      # visiteurs par salle, 2..40
# VITE_PRESENCE_MAX_ROOMS=8           # nombre de salles, 1..50 (au-delà, ou quota Supabase dépassé : mode solo)
# VITE_PRESENCE_SEND_HZ=1             # envois de position par seconde en mouvement, 0.5..4
# VITE_PRESENCE_START=random          # salle d'entrée au hasard (défaut : room-1)

